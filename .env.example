
# TravelBook Studio - save as .env in the project root.
# Replace the API key and model IDs with values from your 9Router instance.
# Keep this file out of Git after adding real keys.

# 9Router (OpenAI-compatible endpoint)
NINE_ROUTER_BASE_URL=http://26.98.193.210:20129/v1
NINE_ROUTER_API_KEY=

# Text model ID from 9Router. Optional fallbacks: comma-separated IDs.
NINE_ROUTER_MODELS=cx/gpt-6.1-sol, cx/gpt-5.6-sol, ag/gemini-3.8-flash

# Image-capable model ID from 9Router (used by Illustrator).
NINE_ROUTER_IMAGE_MODEL=cx/gpt-image-2.6-sunburst, cx/gpt-image-2.5-sunburst

# Backend / frontend
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
DATA_USER_AGENT="TravelBookStudioBot/0.1 (mailto:Thanhtung290705@gmail.com)"
# Workflow
MAX_REVISIONS=3
LLM_TIMEOUT_SECONDS=180

# Optional services: leave blank when not used.
UNSPLASH_ACCESS_KEY=

OPENROUTESERVICE_API_KEY=

# Shared style for AI decorative illustrations.
IMAGE_STYLE_LOCK="Travel editorial illustration, soft watercolor, consistent palette, no text, no labels"