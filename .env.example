UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
IMAGE_STYLE_LOCK=
OPENROUTESERVICE_API_KEY=
NINE_ROUTER_BASE_URL=http://localhost:20128/v1
NINE_ROUTER_API_KEY=
# Exact model IDs from your 9Router catalog, primary first:
NINE_ROUTER_MODELS=
NINE_ROUTER_IMAGE_MODEL=
NINE_ROUTER_IMAGE_FALLBACK_MODELS=
IMAGE_PALETTE="#F3EBDD,#247C82,#C76D4D"
IMAGE_TIMEOUT_SECONDS=180
IMAGE_CACHE_DIR=backend/data/image_cache
# Exact HTTPS hosts permitted when the image API returns a URL instead of base64.
IMAGE_DOWNLOAD_HOSTS=oaidalleapiprodscus.blob.core.windows.net
LLM_TIMEOUT_SECONDS=180
LLM_MAX_ATTEMPTS_PER_MODEL=2
LLM_RETRY_DELAY_SECONDS=0.5
# json_object | json_schema | prompt (when the model lacks response_format support)
LLM_STRUCTURED_OUTPUT_MODE=json_object
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SECONDS=86400
LLM_CACHE_PATH=backend/data/llm_cache.sqlite3
AGENT_REASONING_ENABLED=true
# true: stop when reasoning fails; false: preserve tool/code fallback with an audit record.
AGENT_REASONING_REQUIRED=false

# Reviewer pixel inspection requires a vision-capable Chat Completions model.
# Comma-separated primary and fallback IDs from your 9Router installation.
REVIEWER_VISUAL_ENABLED=true
NINE_ROUTER_VISION_MODELS=
REVIEWER_MAX_IMAGES=12
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
MAX_REVISIONS=3
LAYOUT_LOW_CONFIDENCE_THRESHOLD=0.7
DATA_USER_AGENT=TravelBookStudio/0.1 (travelbook-studio)
DATA_TIMEOUT_SECONDS=25
DATA_CACHE_PATH=backend/data/public_api_cache.sqlite3
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_MIN_INTERVAL_SECONDS=1.1
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_FALLBACK_URLS=https://overpass.private.coffee/api/interpreter
WIKIDATA_QUERY_URL=https://query.wikidata.org/sparql
RESEARCH_WIKIDATA_FALLBACK_ENABLED=true
# Honor configured system proxy for public-data requests. Set false for direct connections.
DATA_TRUST_ENV=true
WIKIDATA_ENTITY_BASE_URL=https://www.wikidata.org/wiki/Special:EntityData
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
RESEARCH_MAX_PLACES=12
RESEARCH_RADIUS_M=15000
RESEARCH_MAX_WIKIDATA_REQUESTS=4
RESEARCH_POPULARITY_ENABLED=true
RESEARCH_CANDIDATE_LIMIT=40
RESEARCH_HIGHLIGHT_RADIUS_M=50000
RESEARCH_PAGEVIEW_LIMIT=24
RESEARCH_POPULARITY_TIMEOUT_SECONDS=45
# Read linked official OSM/Wikidata websites; verify verbatim admission-price evidence.
# Uses the existing text model to select prices. No price is invented if extraction fails.
OFFICIAL_PRICES_ENABLED=true
DESTINATION_GUIDE_ENABLED=true
DESTINATION_GUIDE_TIMEOUT_SECONDS=45
# Unverified economy-tier assumptions used only for budget repairs/scenarios.
BUDGET_ECONOMY_HOTEL_VND_PER_ROOM_NIGHT=400000
BUDGET_ECONOMY_RETURN_VND_PER_PERSON=1200000
OFFICIAL_PRICES_MAX_PLACES=12
OFFICIAL_PRICES_MAX_PAGES=4
OFFICIAL_PRICES_TIMEOUT_SECONDS=12
OFFICIAL_PRICES_TOTAL_TIMEOUT_SECONDS=120
OSRM_BASE_URL=https://router.project-osrm.org
MAP_BASEMAP_ENABLED=true
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_CACHE_DIR=backend/data/map_tile_cache
MAP_TILE_MAX_ZOOM=16
MAP_TILE_MAX_COUNT=16
MAP_NETWORK_TIMEOUT_SECONDS=12
MAP_TOTAL_TIMEOUT_SECONDS=90
ORS_BASE_URL=https://api.openrouteservice.org/v2/matrix
ROUTING_PROVIDER_ORDER=osrm,ors,haversine
ROUTING_MODE=driving
OSRM_DRIVING_PROFILE=driving
# Set walking/cycling only with a server that actually supports that profile.
OSRM_WALKING_PROFILE=
OSRM_CYCLING_PROFILE=
ROUTING_MAX_POINTS=40
ROUTING_HAVERSINE_FACTOR=1.35
# Optional override, otherwise driving=25, walking=4, cycling=12 km/h.
# ROUTING_FALLBACK_SPEED_KMH=25
PLANNER_DAY_START_HOUR=9
PLANNER_DAY_END_HOUR=17
PLANNER_TRANSITION_MINUTES=10
PLANNER_DEFAULT_VISIT_MINUTES=60
PLANNER_MAX_STOPS=4
WIKIMEDIA_API_URL=https://commons.wikimedia.org/w/api.php
UNSPLASH_BASE_URL=https://api.unsplash.com
PEXELS_BASE_URL=https://api.pexels.com/v1
PHOTO_PROVIDER_ORDER=wikimedia,unsplash,pexels
PHOTO_SEARCH_LIMIT=6
PHOTO_MIN_WIDTH=800
PHOTO_MIN_HEIGHT=450
PHOTO_MIN_RELEVANCE=0.75
PHOTO_UTM_SOURCE=travelbook_studio
# Optional; defaults driving=100, walking=15, cycling=50 km/day for declared legs.
# REVIEWER_MAX_DAILY_DISTANCE_KM=100

# Hybrid scheduling: code filters eligible roles, LLM selects a legal batch.
SUPERVISOR_ENABLED=true
SUPERVISOR_FALLBACK_ENABLED=true
